# 本地开发环境变量模板 — 复制此文件为 .env，填入真实值
# cp .env.example .env
#
# 注意:
# 1. .env 不进 git (在 .gitignore 里)
# 2. .env.example 占位符版本进 git, 给后来人看格式
# 3. 启动后端用 ./scripts/run.sh 而不是直接 mvn spring-boot:run
#    (run.sh 自动 source .env 把变量注入 JVM)

# MiniMax T2A v2 API key (国内 https://api.minimaxi.com 控制台拿)
# 鉴权靠 Bearer,例:TTS_API_KEY=sk-cp-abc123def456
MINIMAX_TTS_API_KEY=sk-cp-replace-me
